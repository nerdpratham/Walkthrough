# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder
WORKDIR /app
ARG SLUG=sixdx
ENV VIEWER_BUILD=1
ENV VIEWER_SLUG=$SLUG
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Remove server-only file-proxy routes (nginx serves these in the viewer image).
# Shell single-quotes prevent glob expansion of the literal [slug]/[filename] dirs.
RUN rm -rf 'app/tours/[slug]/panoramas' 'app/tours/[slug]/markers'
RUN find public/tours -mindepth 1 -maxdepth 1 -type d ! -name "$SLUG" -exec rm -rf {} +
COPY --from=tour . public/tours/${SLUG}/
RUN npm run build

FROM nginx:alpine AS runner
ARG SLUG=sixdx
COPY nginx.viewer.conf /tmp/default.conf.template
RUN sed "s/__SLUG__/${SLUG}/g" /tmp/default.conf.template > /etc/nginx/conf.d/default.conf \
  && rm /tmp/default.conf.template
COPY --from=builder /app/out /usr/share/nginx/html
EXPOSE 80
