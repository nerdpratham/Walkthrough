# Path where tours are stored on disk.
# In dev this defaults to ./public/tours — leave unset.
# In production set to the bind-mount path inside the container.
TOURS_DATA_DIR=/data/tours

# Password for the studio (/studio/login).
STUDIO_PASSWORD=change-me

# Secret used to sign session cookies. Use any random 32+ char string.
# Generate one with: openssl rand -base64 32
STUDIO_SECRET=change-me-use-openssl-rand-base64-32
